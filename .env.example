# The application connection. Authenticates as `monarch_app`, an ordinary role
# that owns nothing and IS subject to row-level security. Migration 0002 creates
# this role. Production must give it a password and connect over TLS.
DATABASE_URL=postgres://monarch_app@localhost:5432/monarch_dev

# The owning/superuser connection. Used ONLY by migrations, `db:seed`,
# `db:verify` and `db:test`, which need to see every tenant at once.
# The app never reads this — see src/db/client.ts for why they are separate.
DATABASE_ADMIN_URL=postgres://postgres@localhost:5432/monarch_dev
